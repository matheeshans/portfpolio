# Neon PostgreSQL connection string.
# Copy the pooled connection string from Neon (it usually includes sslmode=require).
DATABASE_URL="postgresql://user:password@ep-example.eu-west-2.aws.neon.tech/portfolio?sslmode=require"

# Resend API key. Keep this server-side; never prefix it with NEXT_PUBLIC_.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"

# Use onboarding@resend.dev for testing, or an address on a verified domain.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
CONTACT_TO_EMAIL="matheeshans@gmail.com"

# Required to access the admin message list.
ADMIN_KEY="replace-with-a-long-random-value"
